# Copy to .env and fill in. Never commit .env.
CRA_GITHUB_APP_ID=
# Paste the PEM with literal \n between lines, e.g. -----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----
CRA_GITHUB_PRIVATE_KEY=
CRA_GITHUB_WEBHOOK_SECRET=
CRA_LOG_LEVEL=INFO

# Sandbox for tools/tests run on untrusted PR code: docker (default) | local | off
CRA_SANDBOX=docker
CRA_SANDBOX_IMAGE=code-review-sandbox:latest
# local mode has NO isolation; only enable on a throwaway dev machine
# CRA_SANDBOX=local
# CRA_ALLOW_UNSAFE_LOCAL_SANDBOX=true

# LLM reviewer. Leave the key empty to run with static analysis and tests only.
CRA_ANTHROPIC_API_KEY=
CRA_LLM_MODEL=claude-sonnet-5-5
# CRA_LLM_TEMPERATURE=0

# Publishing and fixes
# CRA_DRY_RUN=true            # review and log, but post nothing to GitHub
# CRA_ENABLE_FIXES=true       # validate candidate fixes in the sandbox
# CRA_MAX_FIXES=3
# CRA_MAX_INLINE_COMMENTS=10
# CRA_POST_CLEAN_SUMMARY=true # say "nothing found" instead of staying silent
# CRA_MAX_CONCURRENT_REVIEWS=2
# CRA_DATA_DIR=data
